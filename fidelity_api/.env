# Where OUR OWN loyalty database is stored. Aronium never sees this file.
LOYALTY_DB_PATH=./loyalty.db

# Secret key the MOBILE APP must send (X-API-Key header). This is the only
# credential the phones ever hold - it grants no access to pos.db at all.
FIDELITY_API_KEY=API-456

# Where generalAPI is running. Since generalAPI is bound to 127.0.0.1,
# this should normally stay as localhost, even though fidelityAPI itself
# is reachable from the store's Wi-Fi.
GENERAL_API_BASE_URL=http://127.0.0.1:8001

# Must match GENERAL_API_KEY in general_api/.env exactly. This is a
# server-to-server secret; the mobile app never sees it.
GENERAL_API_KEY=API-123

# Points earned per 1 currency unit spent (e.g. 1 => 1 point per $1)
POINTS_PER_CURRENCY_UNIT=1.0

# Currency value of a single point when redeemed for cash-value discounts
# (e.g. 0.05 => 1 point = $0.05). Used as a fallback / for display; product
# redemption (see /points/redeem-product) computes the exact cost from the
# live product price fetched from generalAPI.
POINT_REDEMPTION_VALUE=0.05

# Bind address. This CAN be on the store's isolated Wi-Fi network, since
# this is the only service the mobile app is meant to reach.
HOST=0.0.0.0
PORT=8000

# Separate secret (not FIDELITY_API_KEY!) that gates the staff pickup
# screen - looking up a redemption code, browsing pending pickups, marking
# one fulfilled. Every customer's browser already has FIDELITY_API_KEY
# just to use the app at all, so that key alone can't tell staff from a
# customer. Give this PIN to staff only.
STAFF_PIN=change-me-staff-pin

# How often (seconds) the background loop checks Aronium for new sales
# and awards points for the ones tied to a real customer - this is what
# makes a sale rung up directly at the till earn points automatically.
AUTO_SYNC_INTERVAL_SECONDS=30
