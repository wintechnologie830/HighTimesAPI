# Path to the ARONIUM database (pos.db). This file is only ever READ, never written.
ARONIUM_DB_PATH=C:\Users\alikh\AppData\Local\Aronium\Data\pos.db

# Path to the separate loyalty/points database this API owns and manages.
# Keep this OUTSIDE of the Aronium\Data folder so it never gets touched by Aronium itself.
LOYALTY_DB_PATH=./loyalty.db

# How many points a customer earns per 1 unit of currency spent (e.g. 1 point per $1)
POINTS_PER_CURRENCY_UNIT=1

# Value of 1 point when redeemed, in currency units (e.g. 0.05 = 1 point is worth 5 cents)
POINT_REDEMPTION_VALUE=0.05

# Simple API key the mobile/loyalty app must send in the "X-API-Key" header
API_KEY=change-me-to-a-long-random-secret
