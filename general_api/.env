# Path to Aronium's own database file. This service opens it READ-ONLY,
# never writes to it.
ARONIUM_DB_PATH=C:\Users\alikh\AppData\Local\Aronium\Data\pos.db

# Secret key that ONLY the fidelityAPI service is allowed to know.
# The mobile app never sees this key, and never talks to this service directly.
GENERAL_API_KEY=API-123

# Bind address. Keep this as 127.0.0.1 so this service is NEVER reachable
# from the Wi-Fi network - only from fidelityAPI running on the same machine.
HOST=127.0.0.1
PORT=8001
